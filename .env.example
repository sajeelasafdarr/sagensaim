# ─────────────────────────────────────────────────────────────
# Sage&Saim V1.0 environment variables. Copy to .env and fill in.
# See requirements.md for where to get each value. Never commit .env.
# ─────────────────────────────────────────────────────────────

# App behavior
NODE_ENV=development
# Base URL of the running app (used to build OAuth redirect URIs)
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
# When true, social providers return mocked data and make no real API calls.
SOCIAL_MOCK_MODE=true
# When true, trending hashtags come from a static dev provider.
TRENDING_MOCK_MODE=true
# Browse the UI without Clerk keys (uses local Preview Workspace). Set both.
# UI_PREVIEW_MODE=true
# NEXT_PUBLIC_UI_PREVIEW_MODE=true

# ── Clerk (auth) — required unless UI_PREVIEW_MODE=true ───────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app/home
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app/home

# ── Supabase (DB + storage) — required ───────────────────────
# Use the Session/Transaction pooler for DATABASE_URL, direct connection for DIRECT_URL.
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx
SUPABASE_MEDIA_BUCKET=media

# ── Token encryption — required (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
TOKEN_ENCRYPTION_KEY=

# ── Social platform credentials — optional unless SOCIAL_MOCK_MODE=false ─
# Instagram / Meta Graph API
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# WhatsApp Cloud API (messaging/status only — not a public feed)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Local dev fallback (optional) ────────────────────────────
# When LOCAL_DEV_MODE=true, the app uses the local Postgres from docker-compose
# and a local-disk storage driver instead of Supabase.
LOCAL_DEV_MODE=false
LOCAL_DEV_DATABASE_URL=postgresql://sagesaim:sagesaim@localhost:5432/sagesaim
LOCAL_STORAGE_DIR=.local-storage
